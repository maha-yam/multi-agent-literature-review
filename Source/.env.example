GEMINI_API_KEY=votre_cle_gemini_ici

# Modeles utilises (Gemini via llm_adapter.py)
LLM_SYNTHESIS=gemini-2.0-flash
LLM_GAPS=gemini-2.0-flash
LLM_CHEAP=gemini-2.0-flash

# ChromaDB
CHROMA_DB_PATH=../chroma_db
COLLECTION_NAME=literature_review

# Embedding model (local – aucun coût API)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# LangGraph
RECURSION_LIMIT=10
MAX_FALLBACK_RETRIES=3

# Dossiers
PAPERS_DIR=../papers
LOGS_DIR=../logs
